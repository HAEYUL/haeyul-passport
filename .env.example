# Supabase 설정
# Supabase 대시보드 > Project Settings > API에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 고객 개인정보(이름/전화번호/생년월일) 암호화 키
# 아래 명령을 두 번 실행해 서로 다른 값을 각각 채우세요:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 한 번 설정한 뒤 절대 변경/분실하지 마세요 — 분실 시 저장된 고객정보를
# 복호화할 수 없게 되며 복구 방법이 없습니다. README "개인정보 암호화 키 생성" 참고.
PII_ENCRYPTION_KEY=your-generated-base64-key-here
PII_HASH_KEY=your-generated-base64-key-here

# 앱 설정
# 매장 QR 생성 시 사용할 절대주소 (배포 후에는 실제 운영 도메인으로 설정)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TIMEZONE=Asia/Seoul

# 관리자 초기 비밀번호 (시험판에서만 참고용으로 기록)
# ADMIN_INITIAL_PASSWORD=haeyul8000

# 알리고(Aligo) 문자(SMS) 발송 — smartsms.aligo.in 마이페이지에서 확인
ALIGO_API_KEY=your-aligo-api-key-here
ALIGO_USER_ID=your-aligo-user-id-here
ALIGO_SENDER=발신번호 (사전등록된 번호)

# 생일축하 쿠폰 자동 발급(매일 1회, vercel.json 크론) 보호용 비밀키.
# Vercel 프로젝트 환경변수에 이 값을 설정해두면, Vercel이 크론 요청 시
# Authorization 헤더에 자동으로 담아 보내 외부의 무단 호출을 막아줍니다.
# 임의의 긴 무작위 문자열로 설정하세요.
CRON_SECRET=your-random-secret-here
